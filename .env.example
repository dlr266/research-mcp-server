# Copy this file to .env and fill in your values. .env is git-ignored.

# Optional but recommended. Without a key the server still works on OpenAlex's
# small keyless budget. Get a free key in about 30 seconds: create an account
# at https://openalex.org, then copy the key from your account settings page.
OPENALEX_API_KEY=

# Server-side rate limit per tool (best practice #2). Lower these to demo it.
RATE_LIMIT_CALLS=10
RATE_LIMIT_SECONDS=60
